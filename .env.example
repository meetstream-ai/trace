# npm start generates a setup password and session key in the ignored .env file.
# Remove the APP_PASSWORD line after creating your first named admin.
APP_PASSWORD=
APP_SESSION_SECRET=

# Integrations can be connected in the app. Environment values are optional fallbacks.
MEETSTREAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_ASSIGNEES={}
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_ASSIGNEES={}
SLACK_WEBHOOK_URL=
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Exact trusted webhook URLs grouped by workspace ID.
TRACE_WEBHOOK_ENDPOINTS={}

# Set the exact HTTPS origin on a hosted Worker, with no trailing slash.
TRACE_PUBLIC_ORIGIN=
# Pause external publishing while reconciling a restored database.
TRACE_PAUSE_PUBLISHING=0

# Optional Python meeting agent. See the Optional Python meeting agent section in README.md.
TRACE_MEETING_AGENT_ORIGIN=
TRACE_MEETING_AGENT_ID=
TRACE_MEETING_AGENT_LIVE_TOKEN=
TRACE_MEETING_AGENT_WORKSPACE=local_seedy
